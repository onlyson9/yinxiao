{
  "manifest_version": 3,
  "name": "Cryzen Audio Replacer",
  "version": "1.1",
  "description": "Replace Cryzen.io game audio with custom sounds",
  "content_scripts": [
    {
      "matches": ["*://cryzen.io/*", "*://*.cryzen.io/*"],
      "js": ["loader.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://cryzen.io/*", "*://*.cryzen.io/*"]
    }
  ]
}